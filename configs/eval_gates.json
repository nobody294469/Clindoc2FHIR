{
  "version": "1.0.0",
  "description": "Quality and reliability gate thresholds for ClinicalDoc M-BENCHMARK evaluation",
  "gates": [
    {
      "metric_name": "Synthetic Labs Macro F1",
      "target_threshold": 0.85,
      "dataset_name": "synthetic_labs",
      "path": "macro_f1",
      "comparison": "gte"
    },
    {
      "metric_name": "Synthetic Labs Value Extraction F1",
      "target_threshold": 0.95,
      "dataset_name": "synthetic_labs",
      "path": "field_metrics.lab.value.f1_score",
      "comparison": "gte"
    },
    {
      "metric_name": "Synthetic Meds Medication Name F1",
      "target_threshold": 0.85,
      "dataset_name": "synthetic_meds",
      "path": "field_metrics.med.name.f1_score",
      "comparison": "gte"
    },
    {
      "metric_name": "Synthetic Meds Tuple Accuracy",
      "target_threshold": 0.10,
      "dataset_name": "synthetic_meds",
      "path": "medication_metrics.tuple_accuracy",
      "comparison": "gte"
    },
    {
      "metric_name": "Synthetic Narrative Partial Char Overlap Rate",
      "target_threshold": 0.10,
      "dataset_name": "synthetic_narrative",
      "path": "spatial_grounding.partial_char_overlap_rate",
      "comparison": "gte"
    },
    {
      "metric_name": "Scanned Degraded Labs Macro F1",
      "target_threshold": 0.85,
      "dataset_name": "degraded_scans",
      "path": "macro_f1",
      "comparison": "gte"
    },
    {
      "metric_name": "Real-World Glaucoma Medication Name F1",
      "target_threshold": 0.75,
      "dataset_name": "real_world_glaucoma",
      "path": "field_metrics.med.name.f1_score",
      "comparison": "gte"
    },
    {
      "metric_name": "Verification Cascade Corrupted Claim Rejection (FPRR)",
      "target_threshold": 0.92,
      "dataset_name": "synthetic_labs",
      "path": "verification_metrics.false_positive_rejection_rate",
      "comparison": "gte"
    },
    {
      "metric_name": "Active FHIR Representation Rate",
      "target_threshold": 0.95,
      "dataset_name": "synthetic_labs",
      "path": "fhir_representation.active_representation_rate",
      "comparison": "gte"
    }
  ]
}
